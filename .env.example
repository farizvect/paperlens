# LLM API Configuration (OpenAI-compatible)
# Users can also override these via the Settings dialog in the UI.

LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-key-here

# Security: server-side key fallback is OFF by default.
# On a public deployment, leaving this on turns /api/chat into an open proxy
# that spends YOUR key for anyone who finds the endpoint. Set to 1 only if you
# trust all visitors (e.g. localhost / private LAN usage).
# ALLOW_SERVER_KEY=1
